extwidth]{../input_files/plots/step_8_exit_FTLE_1778069999.png}\n    \\caption{Analysis of chaotic dynamics and vortex ejection. (Left) The long-time Finite-Time Lyapunov Exponent (FTLE) shows no correlation with the vortex residence fraction of tracers (Pearson r = 0.002), indicating that long-term chaoticity is independent of trapping duration. (Right) The distribution of FTLE values at the instant of vortex exit has a mean ($\\mu$ = -0.010) identical to the ensemble average, suggesting that ejection events are not associated with regions of anomalously high chaotic stretching as measured by this long-time metric.}\n    \\label{fig:image5}\n\\end{figure}\n\n\\end{Results}' additional_kwargs={} response_metadata={'finish_reason': 'STOP', 'model_name': 'gemini-2.5-pro', 'safety_ratings': [], 'model_provider': 'google_genai'} id='lc_run--019dfd2b-24ff-7ca2-9bdd-24f1e88cb091-0' tool_calls=[] invalid_tool_calls=[] usage_metadata={'input_tokens': 6555, 'output_tokens': 4937, 'total_tokens': 11492, 'input_token_details': {'cache_read': 0}, 'output_token_details': {'reasoning': 1979}}
