    if len(final_pos_free) > 0:
        ax4.scatter(final_pos_free[:, 0], final_pos_free[:, 1], final_pos_free[:, 2], color='orange', s=10, label='Free')
    ax4.set_xlabel('X')
    ax4.set_ylabel('Y')
    ax4.set_zlabel('Z')
    ax4.set_title('Tracer Trajectories (Subset)')
    ax4.legend()
    fig3.tight_layout()
    fig3.savefig(os.path.join(data_dir, 'vortex_ftle_3_' + timestamp + '.png'), dpi=300)
    plt.close(fig3)
    print('Plots generated successfully.')

if __name__ == '__main__':
