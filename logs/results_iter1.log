    x[6000:7000] = x[0:1000] + np.array([0, eps, 0], dtype=np.float32)
    x[7000:8000] = x[0:1000] + np.array([0, 0, eps], dtype=np.float32)
    x = (x + 0.5) % 1.0 - 0.5
    x_unwrapped = x.copy()
