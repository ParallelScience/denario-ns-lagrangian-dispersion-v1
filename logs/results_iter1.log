    axs1[1, 1].grid(True, which='both', ls='--', alpha=0.7)
    axs1[1, 1].legend()
    fig1.tight_layout()
    fig1.savefig(os.path.join(data_dir, 'msd_results_' + timestamp + '.png'), dpi=300)
