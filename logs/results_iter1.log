            k3 = get_v(x_k3, alpha2, velx1, vely1, velz1, velx2, vely2, velz2)
            x_k4 = (x + k3 * dt_sub + 0.5) % 1.0 - 0.5
            k4 = get_v(x_k4, alpha3, velx1, vely1, velz1, velx2, vely2, velz2)
